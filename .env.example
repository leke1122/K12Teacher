# 高中自学 - 环境变量配置示例

# 请复制此文件为 .env.local 并填入你的实际值

# ==================== AI API Keys ====================

# DeepSeek API (用于 AI 对话和分析)
# 获取地址: https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# 通义千问 API (用于图片识别)
# 获取地址: https://dashscope.console.aliyun.com/
QWEN_API_KEY=your_qwen_api_key_here

# ==================== 讯飞语音合成 (长文) ====================
# 获取地址: https://console.xfyun.cn/
# 服务: 超拟人语音合成 / 长文语音合成

# 讯飞 APP ID
IFLYTEK_APP_ID=your_iflytek_app_id

# 讯飞 API Key
IFLYTEK_API_KEY=your_iflytek_api_key

# 讯飞 API Secret
IFLYTEK_API_SECRET=your_iflytek_api_secret

# ==================== 阿里云语音合成 ====================
# 获取地址: https://nls.console.aliyun.com/
# 服务: 语音合成

# 阿里云 AccessKey ID
ALIYUN_ACCESS_KEY_ID=your_aliyun_access_key_id

# 阿里云 AccessKey Secret
ALIYUN_ACCESS_KEY_SECRET=your_aliyun_access_key_secret

# 阿里云语音合成 AppKey
ALIYUN_TTS_APP_KEY=your_aliyun_tts_app_key

# ==================== Supabase (可选) ====================
# 获取地址: https://supabase.com/

NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
